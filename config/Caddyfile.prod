{
	frankenphp
	admin off
}

# SERVER_NAME controls whether Caddy auto-provisions a real TLS cert:
#   - Unset (default):
#        site address is ":80" -> plain HTTP, no cert attempt.
#        Correct when something in front (LB, reverse proxy, Cloudflare, k8s
#        ingress) already terminates TLS and forwards plain HTTP here.
#   - Set (e.g.SERVER_NAME=vwork.example.com):
#         Caddy automatically requests a Let's Encrypt cert, serves HTTPS on 443,
#         and redirects 80 -> 443. No other change needed in this file when you're
#         ready to go direct.
{$SERVER_NAME}:80 {
	route {
		@assets {
			path /assets/*
		}

		file_server @assets {
			root /app/public
		}

		rewrite index.php
		php {
			root /app/public
			resolve_root_symlink false
			worker index.php {
				match *
			}
		}
	}
}
