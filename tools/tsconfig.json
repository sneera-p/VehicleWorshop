{
   "extends": "./tsconfig.base.json",
   "compilerOptions": {
      "lib": [
         "ESNext",
         "DOM",
         "DOM.Iterable"
      ],
      "paths": {
         "@/*": [
            "../app/resources/ts/*"
         ]
      }
   },
   "include": [
      "../app/resources/ts/**/*.ts",
      "../tools/playwright.config.ts"
   ],
   "exclude": [
      "../node_modules",
      "../public/assets",
      "../vendor"
   ]
}
