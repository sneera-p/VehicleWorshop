{
   "name": "Vehicle Workshop - dev",
   "dockerComposeFile": [
      "../.docker/docker-compose.dev.yml"
   ],

   // VS Code attaches to the test container: it has PHP, Composer, Bun and
   // Playwright, so every suite and tool runs from here. web, db and cache
   // run alongside it as ordinary compose services.
   "service": "test",
   "shutdownAction": "stopCompose",
   "overrideCommand": false,

   "workspaceFolder": "/app",
   "mounts": [
      // Only one of HOME (Linux/macOS) or USERPROFILE (Windows) is ever set,
      // so this resolves to the home folder on every host OS.
      "source=${localEnv:HOME}${localEnv:USERPROFILE}/.gitconfig,target=/root/.gitconfig,type=bind,consistency=cached",
      // .gitconfig alone only carries name/email/aliases — it has nothing
      // to do with authentication. Without this, `git push`/`pull` over SSH fails
      "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/root/.ssh,type=bind,consistency=cached"
   ],

   "postCreateCommand": "git config core.hooksPath .githooks && chmod +x .githooks/*",
   "postStartCommand": "php .tools/phpstan-src.php",

   // No 9003 here: Xdebug connects to the debug listener inside this
   // container, so there is nothing to forward to the host.
   "forwardPorts": ["web:80"],
   "portsAttributes": {
      "web:80": {
         "label": "vwork",
         "onAutoForward": "openBrowser"
      }
   },

   "customizations": {
      "vscode": {
         "extensions": [
            // docker & docker-compose validation
            "ms-azuretools.vscode-containers",
            // database client
            "cweijan.vscode-database-client2",
            // git
            "eamodio.gitlens",
            // editor-tools
            "editorconfig.editorconfig",
            "ionutvmi.path-autocomplete",
            // markdown (.md)
            "davidanson.vscode-markdownlint",
            "shd101wyy.markdown-preview-enhanced",
            // typescript (.ts)
            "oven.bun-vscode",
            "dbaeumer.vscode-eslint",
            "ms-playwright.playwright",
            // scss
            "ecmel.vscode-html-css",
            "mrmlnc.vscode-scss",
            // php
            "junstyle.php-cs-fixer",
            "devsense.composer-php-vscode",
            "bmewburn.vscode-intelephense-client",
            "sanderronde.phpstan-vscode",
            "xdebug.php-debug",
            "recca0120.vscode-phpunit",
            // shell (.sh | .bash)
            "foxundermoon.shell-format",
            // ENV (.env)
            "mikestead.dotenv"
         ],

         "settings": {
            // The test image installs PHP from apt, so it lives in /usr/bin
            // (the FrankenPHP images use /usr/local/bin instead).
            "php.validate.executablePath": "/usr/bin/php"
         }
      }
   },

   "remoteUser": "root",
   "features": {
      "ghcr.io/devcontainers/features/common-utils:2": {
         "installZsh": true,
         "configureZshAsDefaultShell": true,
         "username": "root",
         "userUid": "automatic",
         "userGid": "automatic"
      }
   }
}
