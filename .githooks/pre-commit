#!/bin/sh
# .githooks/pre-commit
#
# Fast checks only — this runs on every single commit, so it needs to feel
# near-instant. Heavier checks (PHPStan, PHPUnit) live in pre-push instead,
# which runs far less often.
#
# One-time setup (per clone): git config core.hooksPath .githooks
# (automated via devcontainer.json's postCreateCommand, so this should
# already be set inside the devcontainer without doing anything manually.)

set -e

STAGED_PHP_FILES=$(git diff --cached --name-only --diff-filter=ACMR -- '*.php')

if [ -z "$STAGED_PHP_FILES" ]; then
   exit 0
fi

echo "Checking PSR-12 compliance on staged PHP files..."

# Dry-run only — does NOT auto-fix and re-stage. Auto-fixing here is a real footgun:
# if a file has both staged and unstaged changes, fixing "the
# file" and re-staging it would silently stage the unstaged parts too,
# not just the fix. Failing with instructions is safer than being clever.
if ! vendor/bin/php-cs-fixer fix --config=.tools/.php-cs-fixer.dist.php --dry-run --diff $STAGED_PHP_FILES; then
   echo ""
   echo "PSR-12 violations found in staged files. Fix with:"
   echo "  vendor/bin/php-cs-fixer fix --config=.tools/.php-cs-fixer.dist.php"
   echo "then re-stage and commit again."
   exit 1
fi

exit 0
