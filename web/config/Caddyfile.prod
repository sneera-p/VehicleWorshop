{
	frankenphp
	admin off
}

# SERVER_NAME decides whether Caddy handles HTTPS itself:
#     Unset (default):
#        the site is ":80", plain HTTP. Use this when something in
#        front (load balancer, reverse proxy, Cloudflare) already terminates TLS.
#     Set (e.g. SERVER_NAME=vwork.example.com):
#        Caddy gets a Let's Encrypt certificate,
#        serves HTTPS on 443 and redirects 80 to 443.
#        The web service must receive SERVER_NAME in docker-compose.yml,
#        and its healthcheck must then call that hostname over HTTPS.

{$SERVER_NAME::80} {
   # Compress text responses (HTML, CSS, JS, JSON).
	encode zstd gzip

   # Built assets: requests under /assets/ (the URL path, not a disk path).
	@assets path /assets/*

	# Only if Bun writes hashed file names (app.3f9a1c.js): let browsers cache
	# assets for a year. With fixed names, users would keep stale files.
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# `route` runs the directives below in the order written.
	route {
		# Assets come straight from disk. A missing file is a 404,
		file_server @assets {
			root /app/web/public
		}

		rewrite /index.php
		php {
			root /app/web/public
			resolve_root_symlink false
			worker index.php {
				match *
			}
		}
	}
}
