{
   // Named commands runnable via Ctrl+Shift+P → "Run Task".
   // "Lint: fix" is the default build task (Ctrl+Shift+B).
   //
   // Unless marked "Host-only", these run inside the devcontainer (the test
   // container), so they use its PHP/Composer/Bun — not the host's.
   "version": "2.0.0",
   "tasks": [
      // ##########################################
      // ────────────────── Lint ──────────────────
      // ##########################################
      {
         "label": "Lint: fix",
         "type": "shell",
         "command": "vendor/bin/php-cs-fixer",
         "args": [
            "fix",
            "--config=.tools/.php-cs-fixer.dist.php"
         ],
         "problemMatcher": [],
         "group": {
            "kind": "build",
            "isDefault": true
         },
         "presentation": {
            "reveal": "always",
            "panel": "shared"
         }
      },
      {
         "label": "Lint: check",
         "type": "shell",
         "command": "vendor/bin/php-cs-fixer",
         "args": [
            "fix",
            "--config=.tools/.php-cs-fixer.dist.php",
            "--dry-run",
            "--diff"
         ],
         "problemMatcher": [],
         "presentation": {
            "reveal": "always",
            "panel": "shared"
         }
      },

      // ##########################################
      // ────────────────── Test ──────────────────
      // ##########################################
      {
         "label": "Test: unit",
         "type": "shell",
         "command": "vendor/bin/phpunit",
         "args": [
            "--configuration=.tools/phpunit.xml.dist",
            "--testsuite=unit"
         ],
         "problemMatcher": [],
         "presentation": {
            "reveal": "always",
            "panel": "shared"
         }
      },
      {
         // Connects to the real db/cache, unlike "Test: unit" — needs them
         // running, and the test container on data_net to reach them.
         "label": "Test: integration",
         "type": "shell",
         "command": "vendor/bin/phpunit",
         "args": [
            "--configuration=.tools/phpunit.xml.dist",
            "--testsuite=integration"
         ],
         "problemMatcher": [],
         "presentation": {
            "reveal": "always",
            "panel": "shared"
         }
      },
      {
         // The devcontainer IS the test container, so Playwright runs here
         // directly, against web over test_net.
         "label": "Test: e2e",
         "type": "shell",
         "command": "bun run test:e2e",
         "problemMatcher": [],
         "presentation": {
            "reveal": "always",
            "panel": "shared"
         }
      },

      // ##########################################
      // ───────────── Static analyse ─────────────
      // ##########################################
      {
         // One PHPStan run covers types (level max), the PHPat architecture
         // tests and ControllerActionRule — see .tools/phpstan.neon.
         "label": "Static Analyse: Types + Architecture",
         "type": "shell",
         "command": "vendor/bin/phpstan",
         "args": [
            "analyse",
            "--configuration=.tools/phpstan.neon"
         ],
         "problemMatcher": [],
         "presentation": {
            "reveal": "always",
            "panel": "shared"
         }
      },
      {
         "label": "Static Analyse: Layer",
         "type": "shell",
         "command": "vendor/bin/deptrac",
         "args": [
            "analyse",
            "--config-file=.tools/deptrac.php"
         ],
         "problemMatcher": [],
         "presentation": {
            "reveal": "always",
            "panel": "shared"
         }
      },

      // ##########################################
      // ───────────────── Docker ─────────────────
      // ##########################################
      // Host-only: run from a terminal not attached to the devcontainer.
      // docker-compose.dev.yml includes everything (web + db + cache + worker + test) — same file the devcontainer itself uses to launch.
      {
         // Attached, not detached (-d) — streams all services' logs live.
         // Never completes on its own; Ctrl+C or "Docker: down" to stop.
         "label": "Docker: up",
         "type": "shell",
         "command": "docker compose -f .docker/docker-compose.dev.yml up",
         "problemMatcher": [],
         "isBackground": true,
         "presentation": {
            "reveal": "always",
            "panel": "dedicated"
         }
      },
      {
         "label": "Docker: down",
         "type": "shell",
         "command": "docker compose -f .docker/docker-compose.dev.yml down",
         "problemMatcher": [],
         "presentation": {
            "reveal": "always",
            "panel": "shared"
         }
      },
      {
         // Filtered view of just "web" — useful if the stack was started
         // another way (e.g. the Dev Containers extension) rather than via
         // "Docker: up" above, which already streams everything.
         "label": "Docker: web logs",
         "type": "shell",
         "command": "docker compose -f .docker/docker-compose.dev.yml logs -f web",
         "problemMatcher": [],
         "presentation": {
            "reveal": "always",
            "panel": "dedicated"
         }
      },
      {
         "label": "Docker: worker logs",
         "type": "shell",
         "command": "docker compose -f .docker/docker-compose.dev.yml logs -f worker",
         "problemMatcher": [],
         "presentation": {
            "reveal": "always",
            "panel": "dedicated"
         }
      },
      {
         // Host-only. Restarts the 2 dev main processes (bun watcher +
         // FrankenPHP) inside the running web container without restarting
         // the container — dev.start.sh auto-detects that FrankenPHP is
         // already up and reloads instead of starting fresh.
         "label": "Docker: restart dev server",
         "type": "shell",
         "command": "docker compose -f .docker/docker-compose.dev.yml exec web sh web/dev.start.sh",
         "problemMatcher": [],
         "presentation": {
            "reveal": "always",
            "panel": "shared"
         }
      },
      {
         // Host-only. console/ has no container of its own — it shares
         // worker's, already-running image. Prompts for the command name/args
         // each run rather than hardcoding one, since this is the
         // general-purpose entrypoint for every console command.
         "label": "Console: run",
         "type": "shell",
         "command": "docker compose -f .docker/docker-compose.dev.yml exec worker php console/main.php ${input:consoleCommand}",
         "problemMatcher": [],
         "presentation": {
            "reveal": "always",
            "panel": "shared"
         }
      },

      // ###########################################
      // ─────────── Assets (Bun + Sass) ───────────
      // ###########################################
      {
         "label": "Assets: build",
         "type": "shell",
         "command": "bun run build",
         "problemMatcher": [],
         "presentation": {
            "reveal": "always",
            "panel": "shared"
         }
      },
      {
         // web's dev.start.sh already runs this watcher. Only use it when
         // web isn't running, or two watchers will fight over public/assets.
         "label": "Assets: watch",
         "type": "shell",
         "command": "bun run dev",
         "problemMatcher": [],
         "isBackground": true,
         "presentation": {
            "reveal": "always",
            "panel": "dedicated"
         }
      },
      {
         "label": "Assets: typecheck",
         "type": "shell",
         "command": "bun run typecheck",
         "problemMatcher": "$tsc",
         "presentation": {
            "reveal": "always",
            "panel": "shared"
         }
      },
      {
         // Root install — resolves web/'s workspace deps into ONE
         // node_modules/ at repo root. web/node_modules should never exist;
         // see "Clean Project Dependencies" below if it ever does.
         "label": "Assets: install",
         "type": "shell",
         "command": "bun install",
         "problemMatcher": [],
         "presentation": {
            "reveal": "always",
            "panel": "shared"
         }
      },
      
      // ###########################################
      // ──────────────── Composite ────────────────
      // ###########################################
      {
         // Matches what pre-push runs — "Test: integration" deliberately
         // excluded, same reasoning: it needs the stack running, and this
         // task shouldn't assume that any more than a git hook should.
         "label": "Check: all",
         "dependsOn": [
            "Lint: check",
            "Static Analyse: Types + Architecture",
            "Static Analyse: Layer"
         ],
         "dependsOrder": "sequence",
         "problemMatcher": []
      },
      {
         // web/node_modules should never exist (workspaces hoist to root),
         // but is cleaned here too in case a stale copy ever reappears —
         // see the note on "Assets: install" above.
         "label": "Clean Project Dependencies",
         "type": "shell",
         "windows": {
            "command": "powershell",
            "args": [
               "-Command",
               "Remove-Item -Recurse -Force 'vendor', 'node_modules', 'web/node_modules', '.var', 'web/public/assets'"
            ]
         },
         "osx": {
            "command": "rm -rf 'vendor' 'node_modules' 'web/node_modules' '.var' 'web/public/assets'"
         },
         "linux": {
            "command": "rm -rf 'vendor' 'node_modules' 'web/node_modules' '.var' 'web/public/assets'"
         },
         "problemMatcher": [],
         "presentation": {
            "echo": true,
            "reveal": "always",
            "focus": false,
            "panel": "shared",
            "showReuseMessage": true,
            "clear": false
         }
      }
   ],
   "inputs": [
      {
         "id": "consoleCommand",
         "type": "promptString",
         "description": "console/ command to run, e.g. \"migrate\" or \"staff:create --name=...\""
      }
   ]
}
