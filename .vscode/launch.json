{
   // Debugger configurations. Press F5 or use the Run & Debug panel.
   //
   // Each config starts a listener inside the test container (where VS Code
   // runs). Xdebug then connects to it:
   //   - tests and CLI scripts: Xdebug in the test container itself
   //     (test stage of web/Dockerfile)
   //   - web requests: Xdebug in the web container, which must be told to
   //     connect to "test" (XDEBUG_CONFIG in docker-compose.dev.yml)
   //
   // Xdebug is set to start_with_request=trigger, so it stays dormant until
   // a debug session actually triggers it — no cost on normal requests.
   //
   // No "pathMappings" needed: the code is at /app in every container, and
   // ${workspaceFolder} is /app too.
   "version": "0.2.0",
   "configurations": [
      {
         // Start this, then load a page with the XDEBUG_TRIGGER cookie set
         // (e.g. via the "Xdebug helper" browser extension). Also used by
         // the PHPUnit extension's "Debug Test" (phpunit.debuggerConfig).
         "name": "Listen for Xdebug (web)",
         "type": "php",
         "request": "launch",
         "port": 9003,
         "skipFiles": [
            "**/vendor/**/*.php"
         ]
      },
      {
         // Needs the worker's Xdebug pointed here, in docker-compose.dev.yml:
         //   XDEBUG_CONFIG: "client_host=test client_port=9004"
         "name": "Listen for Xdebug (worker)",
         "type": "php",
         "request": "launch",
         "port": 9004,
         "skipFiles": [
            "**/vendor/**/*.php"
         ]
      },
      {
         // Debug a single CLI script (whatever file is currently focused)
         // without going through the web server.
         "name": "Debug current script (CLI)",
         "type": "php",
         "request": "launch",
         "program": "${file}",
         "cwd": "${fileDirname}",
         "port": 9003,
         "runtimeArgs": [
            "-dxdebug.start_with_request=yes"
         ]
      }
   ]
}
