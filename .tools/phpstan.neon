parameters:
   # No framework — see README's "no framework" section. No framework
   # extension/stubs needed as a result.

   # Fresh project, no legacy debt to fight — starting at the strictest
   # level rather than working up to it.
   level: max

   paths:
      - ../shared
      - ../domain
      - ../web
      - ../worker
      - ../console

   # Points at each top-level folder, not each package's src/ individually
   # — PHPStan's "paths" doesn't expand wildcards the way PHPUnit's
   # <directory> elements do. Recursing from each top-level folder means
   # new packages (a new domain/modules/*, say) get analyzed automatically
   # with no config edit needed.

   excludePaths:
      - ../web/public/assets/*
      - ../web/node_modules/*
      # Templates get their variables from extract() inside View::render(),
      # which PHPStan can't see, so every variable looks undefined.
      - ../web/resources/views/*
      - ../web/test/Fixtures/*

   ignoreErrors:
      # ControllerStub breaks the action rules on purpose, so
      # ControllerActionTest can check each one is caught.
      -
         identifier: vwork.controllerAction
         path: ../web/test/Stubs/ControllerStub.php

   tmpDir: ../.var/cache/phpstan

# Plain PHPStan rules: checks PHPat can't express.
rules:
   # Every #[ControllerAction] must be:
   # public function name(Request $request, array $attr): Response
   - Vwork\Test\Architecture\ControllerActionRule

# PHPat architecture tests. PHPat only runs classes tagged phpat.test.
# Its extension.neon is included automatically by phpstan/extension-installer;
# without that package, add: includes: [../vendor/phpat/phpat/extension.neon]
services:
   -
      class: Vwork\Test\Architecture\InfrastructureRules
      tags: [phpat.test]
   -
      class: Vwork\Test\Architecture\ModuleRules
      tags: [phpat.test]
   -
      class: Vwork\Test\Architecture\WebRules
      tags: [phpat.test]
