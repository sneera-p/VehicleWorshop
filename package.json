{
   "name": "vwork",
   "private": true,
   "type": "module",
   "scripts": {
      "build:ts": "bun build app/resources/ts/app.ts --outdir public/assets --minify --target browser",
      "build:css": "sass app/resources/scss/app.scss public/assets/app.css --style=compressed --no-source-map",
      "build": "bun run build:ts && bun run build:css",
      "dev:ts": "bun build app/resources/ts/app.ts --outdir public/assets --watch --target browser",
      "dev:css": "sass --watch app/resources/scss/app.scss:public/assets/app.css --style=expanded",
      "dev": "bun run dev:ts & bun run dev:css",
      "typecheck": "tsc --noEmit"
   },
   "devDependencies": {
      "typescript": "^7.0.2",
      "@types/bun": "^1.3.14",
      "sass": "^1.102.0"
   }
}
