{
   "name": "vwork",
   "private": true,
   "type": "module",
   "scripts": {
      "build:ts": "bun build app/resources/ts/*.ts --outdir public/assets --minify --target browser",
      "build:css": "sass app/resources/scss:public/assets --style=compressed --no-source-map",
      "build": "bun run build:ts && bun run build:css",
      "dev:ts": "bun build app/resources/ts/*.ts --outdir public/assets --watch --target browser",
      "dev:css": "sass --watch app/resources/scss:public/assets --style=expanded",
      "dev": "bun run dev:ts & bun run dev:css",
      "typecheck": "tsc -p tools/tsconfig.json && tsc -p tools/tsconfig.test.json",
      "test:e2e": "playwright test --config=tools/playwright.config.ts"
   },
   "devDependencies": {
      "@types/bun": "^1.3.14",
      "@types/node": "^26.2.0",
      "playwright": "^1.62.1",
      "sass": "^1.102.0",
      "typescript": "^7.0.2"
   }
}
